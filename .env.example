# Postgres. On Vercel these come from the Neon integration automatically.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Web application). Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The only Google account allowed to sign in
ALLOWED_EMAIL=blutab@gmail.com

# Secret part of the MCP URL Claude connects to. At least 32 characters. Generate with: openssl rand -hex 32
MCP_SECRET=

# Optional. Bearer token for the Apple Health steps sync (POST /api/health-sync). At least 32 characters.
HEALTH_SYNC_TOKEN=

# Optional. Hevy Pro API key (Hevy web app → Settings → Developer) for strength training sync
HEVY_API_KEY=
# Optional. Bearer token Vercel Cron sends to /api/hevy-sync. At least 32 characters. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Defaults to Europe/Amsterdam
APP_TIME_ZONE=Europe/Amsterdam

# Local development only: skip Google sign-in (ignored in production)
# DEV_SKIP_AUTH=1
